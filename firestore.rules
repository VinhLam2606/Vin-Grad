rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /wishes/{wishId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.matches('.*\\S.*')
        && request.resource.data.name.size() <= 16
        && !request.resource.data.name.matches('.*[/].*')
        && request.resource.data.name != '.'
        && request.resource.data.name != '..'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.matches('.*\\S.*')
        && request.resource.data.message.size() <= 80
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/wishNames/$(request.resource.data.name)).data.name == request.resource.data.name
        && getAfter(/databases/$(database)/documents/wishNames/$(request.resource.data.name)).data.message == request.resource.data.message
        && getAfter(/databases/$(database)/documents/wishNames/$(request.resource.data.name)).data.wishId == wishId;

      allow update, delete: if false;
    }

    match /wishNames/{nameKey} {
      allow get: if true;
      allow list: if false;

      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'wishId'])
        && request.resource.data.keys().hasOnly(['name', 'message', 'wishId'])
        && request.resource.data.name == nameKey
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.matches('.*\\S.*')
        && request.resource.data.name.size() <= 16
        && !request.resource.data.name.matches('.*[/].*')
        && request.resource.data.name != '.'
        && request.resource.data.name != '..'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.matches('.*\\S.*')
        && request.resource.data.message.size() <= 80
        && getAfter(/databases/$(database)/documents/wishes/$(request.resource.data.wishId)).data.name == request.resource.data.name
        && getAfter(/databases/$(database)/documents/wishes/$(request.resource.data.wishId)).data.message == request.resource.data.message;

      allow update, delete: if false;
    }
  }
}
